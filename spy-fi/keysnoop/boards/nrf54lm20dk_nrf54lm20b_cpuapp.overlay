/ {
	chosen {
		ncs,control-output-uart = &uart20;
		/* ncs,control-output-uart = &uart30;*/
	};
};

/ {
    zephyr,user {
        io-channels = <&adc 0>;  
    };
};

&uart30 {
	status = "okay";
	current-speed = <115200>;
};

/* Set high baud rate on the console UART */
&uart20 { /* zephyr,console UART */
    current-speed = <115200>;   /* 1Mbaud */
    status = "okay";
};

&pinctrl {
	pdm20_default_alt: pdm20_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 4)>,
				<NRF_PSEL(PDM_DIN, 1, 5)>;
		};
	};
};

dmic_dev: &pdm20 {
	status = "okay";
	pinctrl-0 = <&pdm20_default_alt>;
	pinctrl-names = "default";
	clock-source = "PCLK32M";
};

&axon {
	status = "okay";
};
